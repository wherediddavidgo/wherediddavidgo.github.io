### take usgs gage number known to have widths and discharge and build percentile rating curve like RODEO
WIDTH_DISCHARGE_RATING_CURVE <- function(sitenum, wQdf) {
# transform 0 width to infinitesimal so logarithm doesn't give error
wQ <- wQdf %>% filter(site_no == sitenum) %>%
mutate(observedWidth = case_when(observedWidth == 0 ~ 1e-50, observedWidth != 0 ~ observedWidth)) %>%
mutate(logFlow = log(Flow), logWidth = log(observedWidth))
# linear regression in log log space
linReg <- lm(wQ$logWidth~wQ$logFlow)
logA <- linReg$coefficients[1]
b <- linReg$coefficients[2]
A <- exp(logA)
# w = aQ^b
wQ <- wQ %>%
mutate(predictedWidth = A * (observedWidth ^ b))
# calculate width rmse
width_rmse <- wQ %>%
filter(!is.na(observedWidth)) %>%
summarize(rmse = sqrt((sum((predictedWidth - observedWidth) ^ 2)) / length(observedWidth[!is.na(observedWidth)])))
# return in order of list: A (coefficient), b (exponent), rmse (predicted vs observed), number of widths
output_stats <- c(as.numeric(A), as.numeric(b), as.numeric(width_rmse), as.numeric(length(wQ$observedWidth)))
return(output_stats)
}
# out <- WIDTH_DISCHARGE_RATING_CURVE('06754000')
ESTIMATE_WIDTH_TIME_SERIES <- function(sitenum, startDate, endDate, drop0=FALSE) {
# Get coefficient and exponent for width/discharge rating curve in the form w = AQ^b
rc_parms <- WIDTH_DISCHARGE_RATING_CURVE(sitenum, drop0)
A <- as.numeric(rc_parms[1])
b <- as.numeric(rc_parms[2])
wQ <- JOIN_WIDTH_DISCHARGE(sitenum, startDate, endDate, drop0) %>%
mutate(estimatedWidth = A * (Flow ^ b))
return(wQ)
}
JOIN_WIDTH_DISCHARGE <- function(sitenum, startDate, endDate, drop0 = FALSE) {
# Get observed widths and gaged flows in m and m^3 s^-1
widths <- readWQPqw(siteNumbers = paste('USGS-', sitenum, sep=''),
parameterCd = "00004") %>%
filter(ActivityMediaName == 'Water') %>%
select('ActivityStartDate', 'ResultMeasureValue') %>%
rename(Date=ActivityStartDate, observedWidth=ResultMeasureValue) %>%
mutate(observedWidth = observedWidth * 0.3048)
flows <- readNWISdv(siteNumbers=sitenum,
parameterCd=c('00060'),
startDate=startDate,
endDate=endDate) %>%
renameNWISColumns() %>%
filter(!is.na(Flow)) %>%
mutate(Flow = Flow * 0.0283168)
# logic to remove NAs and 0s
if(drop0 == TRUE) {
flows <- flows %>%
filter(Flow != 0, na.rm=TRUE)
widths <- widths %>%
filter(observedWidth != 0, na.rm=TRUE)
}
wQ <- flows %>%
left_join(widths, by='Date')
return(wQ)
}
web_widths_alldates <- read_csv('/Users/dego/OneDrive - Virginia Tech/alldate_nwis_width_web_request.csv') %>%
select('Location_Identifier', 'Location_Name', 'Location_Latitude', 'Location_Longitude', 'Activity_StartDate', 'Result_Measure') %>%
mutate(site_no = substr(Location_Identifier, 6, 15)) %>%
rename(c('Date' = 'Activity_StartDate', 'observedWidth'='Result_Measure')) %>%
mutate(observedWidth = observedWidth / 3.28)
val_gage_list <- colocated_wQ$site_no
# get series of widths and discharges for chosen sites
startDate <- sort(web_widths_alldates$Date)[1]
endDate <- '2024-12-31'
flows <- readNWISdv(siteNumbers=val_gage_list, parameterCd='00060', startDate=startDate, endDate=endDate) %>%
renameNWISColumns()
wQs <- left_join(flows, web_widths_alldates, by=c('Date'='Date', 'site_no'='site_no'))
# width and discharge percentiles for each gage
wQs <- wQs %>%
group_by(site_no) %>%
mutate(w_percentile = percent_rank(observedWidth),
Q_percentile = percent_rank(Flow))
# get hydraulic geometry constants at each gage
wQ_ab <- tibble()
for(gage in val_gage_list) {
power_law_parms <- WIDTH_DISCHARGE_RATING_CURVE(gage, wQs)
a <- power_law_parms[1]
b <- power_law_parms[2]
temp <- wQs %>% filter(site_no == gage) %>%
mutate(a = a,
b = b)
wQ_ab <- rbind(wQ_ab, temp)
}
# power law rating curve
wQ_ab <- wQ_ab %>% mutate(predicted_width = a * (Flow ^ b))
# round percentiles to 3 digits, helps when matching with interpolated values
wQ_ab <- wQ_ab %>% mutate(wpr = round(w_percentile, 3),
Qpr = round(Q_percentile, 3))
# function to interpolate w and Q for every 0.1 percentile
MATCH_PERCENTILES <- function(wQdf) {
n <- 1
ws <- wQdf %>% select('observedWidth', 'w_percentile') %>%
filter(!is.na(w_percentile)) %>%
arrange(w_percentile) %>%
unique()
wps <- ws$w_percentile
wp_int <- round(seq(min(wps), max(wps), 0.001), 3)
interpolated_w <- rep(NA, length(wp_int))
# at each percentile step, identify the nearest observed percentile above and below.
# interpolate at step by getting slope between observed
for(p in wp_int) {
if(!p %in% wps) {
pBelow <- wps[wps < p]
pBelow <- pBelow[pBelow - p == max(pBelow - p)]
pAbove <- wps[wps > p]
pAbove <- pAbove[pAbove - p == min(pAbove - p)]
wAbove <- ws[ws$w_percentile == pAbove, 'observedWidth'] %>% as.double()
wBelow <- ws[ws$w_percentile == pBelow, 'observedWidth'] %>% as.double()
dw <- wAbove - wBelow
dp <- pAbove - pBelow
slope <- dw / dp
interpolated_w[n] <- slope * (p - pBelow) + wBelow
} else {
interpolated_w[n] <- ws[ws$w_percentile == p, 'observedWidth'] %>% as.double()
}
n <- n + 1
}
interpolated_w_percentiles <- bind_cols(wp_int, interpolated_w) %>%
rename('interpolated_width'=2, 'percentile'=1)
n <- 1
Qs <- wQdf %>% select('Flow', 'Q_percentile') %>%
filter(!is.na(Q_percentile)) %>%
arrange(Q_percentile) %>%
unique()
Qps <- Qs$Q_percentile
Qp_int <- round(seq(min(Qps), max(Qps), 0.001), 3)
interpolated_Q <- rep(NA, length(Qp_int))
# at each percentile step, identify the nearest observed percentile above and below.
# interpolate at step by getting slope between observed
for(p in Qp_int) {
if(!p %in% Qps) {
pBelow <- Qps[Qps < p]
pBelow <- pBelow[pBelow - p == max(pBelow - p)]
pAbove <- Qps[Qps > p]
pAbove <- pAbove[pAbove - p == min(pAbove - p)]
QAbove <- Qs[Qs$Q_percentile == pAbove, 'Flow'] %>% as.double()
QBelow <- Qs[Qs$Q_percentile == pBelow, 'Flow'] %>% as.double()
dQ <- QAbove - QBelow
dp <- pAbove - pBelow
slope <- dQ / dp
interpolated_Q[n] <- slope * (p - pBelow) + QBelow
} else {
interpolated_Q[n] <- Qs[Qs$Q_percentile == p, 'Flow'] %>% as.double()
}
n <- n + 1
}
interpolated_Q_percentiles <- bind_cols(Qp_int, interpolated_Q) %>%
rename('interpolated_Flow'=2, 'percentile'=1)
perc_rc <- inner_join(interpolated_Q_percentiles, interpolated_w_percentiles, by='percentile')
return(perc_rc)
}
# match width and Q percentiles to build curve
percentile_rcs <- tibble()
for(site in val_gage_list) {
site_df <- wQs %>% filter(site_no == site)
new_rc <- MATCH_PERCENTILES(site_df)
site_no <- rep(site, length(new_rc$percentile))
new_rc <- bind_cols(new_rc, site_no)
percentile_rcs <- (bind_rows(percentile_rcs, new_rc))
}
